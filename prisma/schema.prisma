generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ModuleStatus {
  not_started
  scripting
  pre_production
  production
  post_production
  building
  playtesting
  signed_off
  deployed
}

enum DocumentType {
  storyboard
  script
  rundown
  shot_sheet
  two_d_assets
  playtest_notes
  box_folder
  other
}

enum TaskPhase {
  pre_production
  scripting
  production
  post_production
  uptale_build
  playtesting
  sign_off
  deployment
}

enum TaskStatus {
  not_started
  in_progress
  blocked
  completed
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  documentLinksAdded DocumentLink[]

  @@map("users")
}

/// A single VR training module (e.g. "M5: Etching 1 - Wet", "Youth Outreach").
model Module {
  id                 String       @id @default(cuid())
  number             String
  name               String
  status             ModuleStatus @default(not_started)
  description        String?
  learningObjectives String?
  toolsUsed          String?
  featuresDiscussed  String?
  /// Loose string, not a real date — CNF's own tracking uses values like "Fall 2025"
  targetCompletion   String?
  runtimeMinutes     Int?
  /// Uptale platform experience ID, once built
  experienceId       String?
  launchUrl          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  scenes        Scene[]
  documentLinks DocumentLink[]
  tasks         Task[]
  changeOrders  ChangeOrder[]

  @@map("modules")
}

/// A scene within a module. Doubles as the Discovery Form's per-scene capture
/// (filled early, sparse) and the general production scene list (filled in over time).
model Scene {
  id                     String  @id @default(cuid())
  moduleId               String
  order                  Int
  title                  String?
  location               String?
  talent                 String?
  backgroundMediaType    String?
  speaker                String?
  toolUsed               String?
  interactionHighlighted String?
  notes                  String?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  documentLinks DocumentLink[]

  @@map("scenes")
}

/// A link out to an artifact that lives in Google Drive/Box (storyboard, script, etc.) —
/// this app does not host or edit the document itself, per the v1 architecture decision.
model DocumentLink {
  id        String       @id @default(cuid())
  moduleId  String
  sceneId   String?
  type      DocumentType
  label     String?
  url       String
  addedById String?
  addedAt   DateTime     @default(now())

  module  Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scene   Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  addedBy User?  @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@map("document_links")
}

/// A production task for a module, replacing CNF's per-module timeline tables
/// (Project Binder) that tracked owner/dates/status by phase.
model Task {
  id        String     @id @default(cuid())
  moduleId  String
  phase     TaskPhase
  title     String
  owner     String?
  status    TaskStatus @default(not_started)
  startDate DateTime?
  dueDate   DateTime?
  notes     String?
  order     Int        @default(0)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

/// Logs a change to an already-locked/signed-off module, mirroring the schema CNF
/// already uses in its own Track Changes spreadsheet.
model ChangeOrder {
  id             String    @id @default(cuid())
  moduleId       String
  /// Not a Scene FK — CNF's own log references scenes loosely (e.g. "ALL SCENES")
  sceneRef       String?
  description    String
  status         String?
  suggestedBy    String?
  suggestedDate  DateTime?
  goalDate       DateTime?
  approvedBy     String?
  completedDate  DateTime?
  versionUpdated Boolean   @default(false)
  notes          String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("change_orders")
}
