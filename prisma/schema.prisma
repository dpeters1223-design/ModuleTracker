generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Declared in pipeline order (Postgres sorts enums by declaration order).
enum ModuleStatus {
  on_hold
  not_started
  pre_production
  scripting
  production
  post_production
  building
  playtesting
  signed_off
  deployed
}

enum DocumentType {
  storyboard
  script
  /// A copy of the script being edited separately from the official one. Promoting
  /// it swaps it in as `script`; the one it replaces becomes a script_draft itself,
  /// so nothing is ever silently lost.
  script_draft
  rundown
  shot_sheet
  questions
  two_d_assets
  three_d_assets
  playtest_notes
  /// A Box / Google Drive / shared folder
  folder
  other
}

enum TaskPhase {
  pre_production
  scripting
  production
  post_production
  build
  playtesting
  sign_off
  deployment
}

/// What kind of media an asset is (matches the scene activity types).
enum AssetType {
  image2d
  video2d
  object3d
  audio
  other
}

/// Where an asset stands: asked for, on its way, in hand, built into Uptale.
enum AssetStatus {
  needed
  requested
  received
  in_uptale
}

enum TaskStatus {
  not_started
  in_progress
  /// Playthrough tasks only: the write-up has been submitted, waiting on review/follow-up.
  feedback_submitted
  delayed
  completed
}

enum ChangeOrderStatus {
  suggested
  approved
  in_progress
  in_review
  completed
  deferred
  declined
}

/// "team": the one always-on channel, open to every allowlisted user with no
/// membership row needed. "group": a DM or small group, gated by ChatChannelMember.
enum ChatChannelKind {
  team
  group
}

/// Where a media item stands in Tom's review of an album flagged `needsReview`.
/// A row only exists once someone has looked at the item; absent means pending.
enum MediaReviewStatus {
  pending
  approved
  changes_requested
}

/// How much a channel should count towards someone's unread badge.
/// "mentions" behaves like "none" until @-mentions are built.
enum ChatNotifyLevel {
  all
  mentions
  none
}

/// The four fixed message reactions — a small set, not an open emoji picker.
enum ChatReactionKind {
  thumbs_up
  thumbs_down
  heart
  dog
}

/// What kind of thing a piece of feedback is about. A write-up can be more than
/// one of these at once (e.g. both instructional_design and ui_ux).
enum FeedbackCategory {
  instructional_design
  ui_ux
  media
  tags
}

/// Where one of Jay's feature requests stands.
enum FeatureRequestStatus {
  new
  planned
  in_progress
  declined
  done
}

/// A second visual axis (alongside color-by-category) on the dependency graph.
enum DependencyNodeShape {
  circle
  square
  diamond
  hexagon
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  /// Google OAuth tokens (scope: drive.file), saved at sign-in so server code
  /// can create/import Docs as this user. Never sent to the browser.
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  /// When this user last opened their notifications (the bell)
  lastSeenActivityAt   DateTime?

  documentLinksAdded             DocumentLink[]
  attachmentsAdded               TaskAttachment[]
  chatChannelsCreated            ChatChannel[]
  chatChannelMemberships         ChatChannelMember[]
  chatMessages                   ChatMessage[]
  chatProfile                    ChatProfile?
  modulesSignedOff               Module[]                   @relation("ModuleSignOff")
  playthroughFeedback            PlaythroughFeedback[]
  mediaItemsAdded                MediaItem[]
  mediaAlbumsCreated             MediaAlbum[]
  taskComments                   TaskComment[]
  mediaReviews                   MediaReview[]
  featureRequests                FeatureRequest[]
  featureRequestAttachmentsAdded FeatureRequestAttachment[]
  chatMessageReactions           ChatMessageReaction[]

  @@map("users")
}

/// A single VR training module. Modules are created in the app; nothing about
/// a particular organization's module list is baked in.
model Module {
  id                 String       @id @default(cuid())
  /// Optional short code the team uses, e.g. "PVD1"
  number             String?
  name               String
  status             ModuleStatus @default(not_started)
  description        String?
  audience           String?
  keyConcepts        String?
  learningObjectives String?
  toolsUsed          String?
  featuresDiscussed  String?
  /// Loose string, not a real date — teams often plan in values like "Fall 2026"
  targetCompletion   String?
  runtimeMinutes     Int?
  sizeMb             Float?
  /// Google Drive folder the app created for this module's docs
  driveFolderId      String?
  /// When the module was formally signed off. Set means done; the module is NOT
  /// archived and can still be changed.
  signedOffAt        DateTime?
  signedOffById      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  signedOffBy     User?            @relation("ModuleSignOff", fields: [signedOffById], references: [id], onDelete: SetNull)
  scenes          Scene[]
  documentLinks   DocumentLink[]
  tasks           Task[]
  changeOrders    ChangeOrder[]
  versions        ModuleVersion[]
  assets          ModuleAsset[]
  mediaItems      MediaItem[]
  mediaAlbums     MediaAlbum[]
  dependencyNodes DependencyNode[]
  dependencyEdges DependencyEdge[]
  featureRequests FeatureRequest[]

  @@map("modules")
}

/// A published build of a module on the delivery platform (e.g. Uptale).
/// A module can have several — one per version, and per workspace when it is
/// cloned into other organizations' workspaces.
model ModuleVersion {
  id           String    @id @default(cuid())
  moduleId     String
  /// e.g. "v3", "v2.01"
  version      String
  platform     String?
  workspace    String?
  /// The platform's ID for this build
  experienceId String?
  launchUrl    String?
  releasedAt   DateTime?
  notes        String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_versions")
}

/// A scene within a module. Doubles as the Discovery Form's per-scene capture
/// (filled early, sparse) and the general production scene list (filled in over time).
model Scene {
  id                     String  @id @default(cuid())
  moduleId               String
  order                  Int
  title                  String?
  description            String?
  location               String?
  talent                 String?
  backgroundMediaType    String?
  speaker                String?
  toolUsed               String?
  interactionHighlighted String?
  learningObjectives     String?
  /// Free-text activity notes (the structured parts are interactions/questions)
  activities             String?
  /// Checked interaction types with notes: [{ type, note }] (see src/lib/interactions.ts)
  interactions           Json    @default("[]")
  /// 1 = standard tags, 2 = custom 2D/3D elements, 3 = fully custom multi-step activity
  interactivityLevel     Int?
  /// Quiz questions: [{ question, options: [{ text, correct }], feedback }]
  questions              Json    @default("[]")
  mediaAssets            String?
  notes                  String?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  documentLinks DocumentLink[]
  assets        ModuleAsset[]
  mediaItems    MediaItem[]

  @@map("scenes")
}

/// A link out to an artifact that lives in Google Drive/Box (storyboard, script, etc.) —
/// this app does not host or edit the document itself, per the v1 architecture decision.
model DocumentLink {
  id          String       @id @default(cuid())
  moduleId    String
  sceneId     String?
  type        DocumentType
  label       String?
  url         String
  /// Set when the file is a Google Drive file the app can read metadata for
  driveFileId String?
  addedById   String?
  addedAt     DateTime     @default(now())

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scene           Scene?           @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  addedBy         User?            @relation(fields: [addedById], references: [id], onDelete: SetNull)
  featureRequests FeatureRequest[]

  @@map("document_links")
}

/// A production task for a module, with owner, dates and status, grouped by phase.
model Task {
  id            String     @id @default(cuid())
  moduleId      String
  phase         TaskPhase
  title         String
  owner         String?
  status        TaskStatus @default(not_started)
  startDate     DateTime?
  dueDate       DateTime?
  notes         String?
  order         Int        @default(0)
  /// Set on a sub-task: the task it belongs to (one level only). Deleting the parent deletes it.
  parentId      String?
  /// A playthrough: whoever owns it is expected to play the module and write up
  /// what happened, so the task gets a feedback tab instead of just a notes box.
  isPlaythrough Boolean    @default(false)

  module          Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  parent          Task?                 @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]                @relation("Subtasks")
  attachments     TaskAttachment[]
  feedback        PlaythroughFeedback[]
  comments        TaskComment[]
  featureRequests FeatureRequest[]

  @@index([parentId])
  @@map("tasks")
}

/**
 * A comment on a task, with optional @mentions (parsed from `body` at write time —
 * see src/lib/mentions.ts) that ping the mentioned person on Slack. Unlike
 * PlaythroughFeedback this is for any task, not just playthroughs: a quick "how's
 * this going?" on something overdue.
 */
model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String?
  /// Snapshot, so a comment still says who wrote it if the user is ever removed.
  authorName String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// An image attached to a task or sub-task. The file lives in the Drive owner's
/// "ModuleTracker Attachments" folder; the app serves it to signed-in users.
model TaskAttachment {
  id          String   @id @default(cuid())
  /// Exactly one of taskId / assetId is set.
  taskId      String?
  assetId     String?
  driveFileId String
  name        String
  mimeType    String
  addedById   String?
  addedAt     DateTime @default(now())

  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset   ModuleAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  addedBy User?        @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([assetId])
  @@map("task_attachments")
}

/**
 * A write-up of one playthrough of a module: usually a long transcript of what the
 * person saw, said and struggled with. Several people can play the same task, and
 * one person can submit more than once, so these are rows rather than a field.
 * authorName is a snapshot so a write-up still says who wrote it later.
 */
model PlaythroughFeedback {
  id         String             @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String?
  body       String
  /// What this write-up is about. Empty until someone clicks "AI Sort" (or sets
  /// it by hand) — categorization is a manual action, not automatic on submit.
  /// Derived from `tags` (the union of categories mentioned there).
  categories FeedbackCategory[] @default([])
  /// The specific phrases "AI Sort" found and which category each belongs to —
  /// `{ quote: string, category: FeedbackCategory }[]`, highlighted inline in
  /// the body on display. `quote` must be an exact substring of `body`; a tag
  /// whose quote no longer matches (edited write-up) is just dropped at render
  /// time rather than shown wrong.
  tags       Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("playthrough_feedback")
}

/**
 * A file in the media library: an actual image, video, document or audio file the team
 * has, or a link to one held somewhere else.
 * Deliberately NOT a ModuleAsset. An asset is something a module *needs* (tracked
 * needed → received → in Uptale) and most assets never have a file; a media item is a
 * file that exists, and may belong to no module at all. Where the two line up, a media
 * item can point at its asset.
 * Organised by `tags` rather than by hierarchy: a tag like "reference" or "wafer
 * carrier" is what relates one image to another, so there is no image-to-image link.
 */
model MediaItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Free text, chosen from what has been used before. Lowercased on save so
  /// "Reference" and "reference" are the same tag.
  tags        String[] @default([])

  /// An uploaded file: the Drive file holding the bytes, served via /api/media/[id].
  driveFileId String?
  mimeType    String?
  bytes       Int?
  /// A smaller copy made at upload time, so a grid of thumbnails isn't a grid of
  /// full-size photos. Only set for images.
  thumbFileId String?
  /// Set instead of driveFileId when the media lives somewhere else entirely.
  url         String?

  /// All optional: a media item can belong to nothing.
  moduleId  String?
  sceneId   String?
  assetId   String?
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module          Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  scene           Scene?           @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  asset           ModuleAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  addedBy         User?            @relation(fields: [addedById], references: [id], onDelete: SetNull)
  albums          MediaAlbumItem[]
  reviews         MediaReview[]
  featureRequests FeatureRequest[]

  @@index([moduleId])
  @@index([assetId])
  @@index([tags], type: Gin)
  @@map("media_items")
}

/**
 * A named set of media, assembled two ways at once: everything carrying one of the
 * album's `tags` is in it automatically, and anything else can be pinned in by hand.
 * So "Reference images" stays current on its own, while "Shots for Tom's review" is
 * a deliberate selection — both are albums.
 * An album can be attached to a module, which is what makes it show on that module's
 * page; unattached albums live only in the library.
 */
model MediaAlbum {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Membership rule: any media item carrying ANY of these tags belongs to the album.
  /// Empty means the album is hand-picked only.
  tags        String[] @default([])
  moduleId    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Flags this album as a review set (e.g. for Tom to check): items in it get a
  /// pending/approved/changes-requested control instead of just edit/remove.
  needsReview Boolean  @default(false)

  module    Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     MediaAlbumItem[]
  reviews   MediaReview[]

  @@index([moduleId])
  @@map("media_albums")
}

/**
 * One person's review of one media item within one album. Keyed on the pair rather
 * than living on MediaAlbumItem because a tag-matched item (see MediaAlbumItem's
 * comment) has no row there at all — a review can still apply to it. Absent means
 * pending; only existing rows (approved / changes_requested) are stored.
 */
model MediaReview {
  id           String            @id @default(cuid())
  albumId      String
  mediaId      String
  status       MediaReviewStatus @default(pending)
  note         String?
  reviewedById String?
  reviewedAt   DateTime          @updatedAt

  album      MediaAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media      MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([albumId, mediaId])
  @@index([mediaId])
  @@map("media_reviews")
}

/// One hand-pinned item in an album. Tag-matched items are not stored here — they
/// are resolved at read time, so re-tagging an image updates every album at once.
model MediaAlbumItem {
  id      String   @id @default(cuid())
  albumId String
  mediaId String
  order   Int      @default(0)
  addedAt DateTime @default(now())

  album MediaAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([albumId, mediaId])
  @@index([mediaId])
  @@map("media_album_items")
}

/// A requested change to a module that is already signed off or deployed.
model ChangeOrder {
  id             String            @id @default(cuid())
  /// Null means the change applies to all modules
  moduleId       String?
  /// Free text, not a Scene FK — changes often span scenes (e.g. "all scenes")
  sceneRef       String?
  description    String
  status         ChangeOrderStatus @default(suggested)
  suggestedBy    String?
  suggestedDate  DateTime?
  goalDate       DateTime?
  approvedBy     String?
  completedDate  DateTime?
  versionUpdated Boolean           @default(false)
  notes          String?

  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("change_orders")
}

/// One change made in the app: who, what, when, plus enough before/after data to
/// undo it. Module id/label are plain copies (no foreign key) so history survives
/// the module being deleted.
model ActivityLog {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  actorId     String?
  actorEmail  String
  actorName   String?
  /// e.g. "task.create", "module.status", "discovery.update"
  action      String
  /// Human-readable, e.g. Moved "Film scenes 1–4" to Post-production
  summary     String
  moduleId    String?
  moduleLabel String?
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  undoneAt    DateTime?
  undoneBy    String?

  @@index([createdAt])
  @@index([moduleId, createdAt])
  @@map("activity_log")
}

/**
 * A media asset a module needs (a 2D image, 2D video, 3D object…), tracked from
 * "needed" to "in Uptale". Rows made from a scene's activities carry a sourceKey so
 * "Add from scenes" can tell which scene items are already listed.
 */
model ModuleAsset {
  id        String      @id @default(cuid())
  moduleId  String
  sceneId   String?
  name      String
  type      AssetType   @default(other)
  /// Who is providing or making it (free text, matched like task owners)
  owner     String?
  status    AssetStatus @default(needed)
  url       String?
  notes     String?
  sourceKey String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scene           Scene?           @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  attachments     TaskAttachment[]
  mediaItems      MediaItem[]
  dependencyNodes DependencyNode[]

  @@index([moduleId])
  @@map("module_assets")
}

/// A chat channel: either the single always-on "team" channel (every allowlisted
/// user can read/post, no membership row needed) or a user-created group/DM
/// channel (membership in ChatChannelMember gates access).
model ChatChannel {
  id          String          @id @default(cuid())
  kind        ChatChannelKind @default(group)
  /// Null for the team channel and for a 2-person DM (the UI shows the other
  /// member's name instead); set for a named 3+ person group.
  name        String?
  createdById String?
  createdAt   DateTime        @default(now())

  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatChannelMember[]
  messages  ChatMessage[]

  @@map("chat_channels")
}

/// Who belongs to a group channel, and where they last read it. For the team
/// channel this only exists once a user has opened it (to store lastReadAt).
model ChatChannelMember {
  id          String           @id @default(cuid())
  channelId   String
  userId      String
  /// Null = never opened this channel, so everything in it is unread.
  lastReadAt  DateTime?
  /// Null = use the person's ChatProfile default. Set to mute just this channel.
  notifyLevel ChatNotifyLevel?
  joinedAt    DateTime         @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}

/**
 * Per-person chat settings. Separate from User because User.name and User.image are
 * overwritten from Google on every sign-in (src/auth.ts), so a chosen nickname or
 * avatar could not survive there.
 */
model ChatProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  /// Shown instead of the Google account name. Null = use User.name.
  nickname       String?
  /// An emoji used as this person's avatar; wins over their Google photo.
  emoji          String?
  /// false = never show my Google profile photo in chat.
  useGooglePhoto Boolean         @default(true)
  /// Default for channels with no ChatChannelMember.notifyLevel of their own.
  notifyLevel    ChatNotifyLevel @default(all)
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_profiles")
}

/// One chat message. Text only in v1 — no edit/delete, no attachments.
model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  channel   ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions ChatMessageReaction[]

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

/// One person's "like/acknowledge" on a message — a single fixed reaction, not a
/// pick-an-emoji set, since that's all David asked for. One per person per message.
model ChatMessageReaction {
  id        String           @id @default(cuid())
  messageId String
  userId    String
  kind      ChatReactionKind @default(thumbs_up)
  createdAt DateTime         @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One person can stack more than one of the four on the same message, just not the same one twice.
  @@unique([messageId, userId, kind])
  @@index([messageId])
  @@map("chat_message_reactions")
}

/// One of Jay's feature requests for the app itself (not a module change — see
/// ChangeOrder for those). Submit-anywhere, visible-to-everyone inbox so ideas
/// stop living only in Slack.
model FeatureRequest {
  id              String               @id @default(cuid())
  title           String
  body            String?
  submittedById   String?
  /// Snapshot, so a request still says who asked for it if the user is removed.
  submittedByName String?
  status          FeatureRequestStatus @default(new)
  /// Optional "tag" references to whatever the request is about. Not ownership —
  /// losing the referenced row just clears the tag, never deletes the request.
  moduleId        String?
  taskId          String?
  mediaItemId     String?
  documentLinkId  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  submittedBy  User?                      @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  module       Module?                    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  task         Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  mediaItem    MediaItem?                 @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)
  documentLink DocumentLink?              @relation(fields: [documentLinkId], references: [id], onDelete: SetNull)
  attachments  FeatureRequestAttachment[]

  @@index([createdAt])
  @@map("feature_requests")
}

/// An image attached directly to a feature request (as opposed to tagging an
/// existing MediaItem) — same Drive-backed pattern as TaskAttachment.
model FeatureRequestAttachment {
  id               String   @id @default(cuid())
  featureRequestId String
  driveFileId      String
  name             String
  mimeType         String
  addedById        String?
  addedAt          DateTime @default(now())

  featureRequest FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  addedBy        User?          @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([featureRequestId])
  @@map("feature_request_attachments")
}

/// One item in a module's dependency graph (usually mirrors an Uptale tag).
/// Independent of Uptale — Jay lays this out by hand to show how dependencies
/// should be built, rather than this reading Uptale's own data live.
model DependencyNode {
  id        String              @id @default(cuid())
  moduleId  String
  assetId   String?
  label     String
  /// Free text, Jay's own grouping — not FeedbackCategory. Color is derived from
  /// this string at render time rather than stored.
  category  String?
  shape     DependencyNodeShape @default(circle)
  /// Saved canvas position, so the layout survives a page reload.
  x         Float               @default(0)
  y         Float               @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  asset     ModuleAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  edgesFrom DependencyEdge[] @relation("EdgeFrom")
  edgesTo   DependencyEdge[] @relation("EdgeTo")

  @@index([moduleId])
  @@map("dependency_nodes")
}

/// A directed "must happen before" link between two nodes in the same module.
model DependencyEdge {
  id         String   @id @default(cuid())
  moduleId   String
  fromNodeId String
  toNodeId   String
  createdAt  DateTime @default(now())

  module   Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  fromNode DependencyNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   DependencyNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([moduleId])
  @@map("dependency_edges")
}
