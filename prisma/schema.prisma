generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Declared in pipeline order (Postgres sorts enums by declaration order).
enum ModuleStatus {
  on_hold
  not_started
  pre_production
  scripting
  production
  post_production
  building
  playtesting
  signed_off
  deployed
}

enum DocumentType {
  storyboard
  script
  rundown
  shot_sheet
  questions
  two_d_assets
  three_d_assets
  playtest_notes
  /// A Box / Google Drive / shared folder
  folder
  other
}

enum TaskPhase {
  pre_production
  scripting
  production
  post_production
  build
  playtesting
  sign_off
  deployment
}

enum TaskStatus {
  not_started
  in_progress
  delayed
  completed
}

enum ChangeOrderStatus {
  suggested
  approved
  in_progress
  in_review
  completed
  deferred
  declined
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  /// Google OAuth tokens (scope: drive.file), saved at sign-in so server code
  /// can create/import Docs as this user. Never sent to the browser.
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?

  documentLinksAdded DocumentLink[]

  @@map("users")
}

/// A single VR training module. Modules are created in the app; nothing about
/// a particular organization's module list is baked in.
model Module {
  id                 String       @id @default(cuid())
  /// Optional short code the team uses, e.g. "PVD1"
  number             String?
  name               String
  status             ModuleStatus @default(not_started)
  description        String?
  audience           String?
  keyConcepts        String?
  learningObjectives String?
  toolsUsed          String?
  featuresDiscussed  String?
  /// Loose string, not a real date — teams often plan in values like "Fall 2026"
  targetCompletion   String?
  runtimeMinutes     Int?
  sizeMb             Float?
  /// Google Drive folder the app created for this module's docs
  driveFolderId      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  scenes        Scene[]
  documentLinks DocumentLink[]
  tasks         Task[]
  changeOrders  ChangeOrder[]
  versions      ModuleVersion[]

  @@map("modules")
}

/// A published build of a module on the delivery platform (e.g. Uptale).
/// A module can have several — one per version, and per workspace when it is
/// cloned into other organizations' workspaces.
model ModuleVersion {
  id           String    @id @default(cuid())
  moduleId     String
  /// e.g. "v3", "v2.01"
  version      String
  platform     String?
  workspace    String?
  /// The platform's ID for this build
  experienceId String?
  launchUrl    String?
  releasedAt   DateTime?
  notes        String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_versions")
}

/// A scene within a module. Doubles as the Discovery Form's per-scene capture
/// (filled early, sparse) and the general production scene list (filled in over time).
model Scene {
  id                     String  @id @default(cuid())
  moduleId               String
  order                  Int
  title                  String?
  description            String?
  location               String?
  talent                 String?
  backgroundMediaType    String?
  speaker                String?
  toolUsed               String?
  interactionHighlighted String?
  learningObjectives     String?
  /// Quizzes, clickables and other activities in the scene
  activities             String?
  mediaAssets            String?
  notes                  String?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  documentLinks DocumentLink[]

  @@map("scenes")
}

/// A link out to an artifact that lives in Google Drive/Box (storyboard, script, etc.) —
/// this app does not host or edit the document itself, per the v1 architecture decision.
model DocumentLink {
  id          String       @id @default(cuid())
  moduleId    String
  sceneId     String?
  type        DocumentType
  label       String?
  url         String
  /// Set when the file is a Google Drive file the app can read metadata for
  driveFileId String?
  addedById   String?
  addedAt     DateTime     @default(now())

  module  Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scene   Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  addedBy User?  @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@map("document_links")
}

/// A production task for a module, with owner, dates and status, grouped by phase.
model Task {
  id        String     @id @default(cuid())
  moduleId  String
  phase     TaskPhase
  title     String
  owner     String?
  status    TaskStatus @default(not_started)
  startDate DateTime?
  dueDate   DateTime?
  notes     String?
  order     Int        @default(0)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

/// A requested change to a module that is already signed off or deployed.
model ChangeOrder {
  id             String            @id @default(cuid())
  /// Null means the change applies to all modules
  moduleId       String?
  /// Free text, not a Scene FK — changes often span scenes (e.g. "all scenes")
  sceneRef       String?
  description    String
  status         ChangeOrderStatus @default(suggested)
  suggestedBy    String?
  suggestedDate  DateTime?
  goalDate       DateTime?
  approvedBy     String?
  completedDate  DateTime?
  versionUpdated Boolean           @default(false)
  notes          String?

  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("change_orders")
}
