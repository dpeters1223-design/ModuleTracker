generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Declared in pipeline order (Postgres sorts enums by declaration order).
enum ModuleStatus {
  on_hold
  not_started
  pre_production
  scripting
  production
  post_production
  building
  playtesting
  signed_off
  deployed
}

enum DocumentType {
  storyboard
  script
  rundown
  shot_sheet
  questions
  two_d_assets
  three_d_assets
  playtest_notes
  /// A Box / Google Drive / shared folder
  folder
  other
}

enum TaskPhase {
  pre_production
  scripting
  production
  post_production
  build
  playtesting
  sign_off
  deployment
}

/// What kind of media an asset is (matches the scene activity types).
enum AssetType {
  image2d
  video2d
  object3d
  audio
  other
}

/// Where an asset stands: asked for, on its way, in hand, built into Uptale.
enum AssetStatus {
  needed
  requested
  received
  in_uptale
}

enum TaskStatus {
  not_started
  in_progress
  delayed
  completed
}

enum ChangeOrderStatus {
  suggested
  approved
  in_progress
  in_review
  completed
  deferred
  declined
}

/// "team": the one always-on channel, open to every allowlisted user with no
/// membership row needed. "group": a DM or small group, gated by ChatChannelMember.
enum ChatChannelKind {
  team
  group
}

/// How much a channel should count towards someone's unread badge.
/// "mentions" behaves like "none" until @-mentions are built.
enum ChatNotifyLevel {
  all
  mentions
  none
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  /// Google OAuth tokens (scope: drive.file), saved at sign-in so server code
  /// can create/import Docs as this user. Never sent to the browser.
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  /// When this user last opened their notifications (the bell)
  lastSeenActivityAt   DateTime?

  documentLinksAdded     DocumentLink[]
  attachmentsAdded       TaskAttachment[]
  chatChannelsCreated    ChatChannel[]
  chatChannelMemberships ChatChannelMember[]
  chatMessages           ChatMessage[]
  chatProfile            ChatProfile?
  modulesSignedOff       Module[]              @relation("ModuleSignOff")
  playthroughFeedback    PlaythroughFeedback[]

  @@map("users")
}

/// A single VR training module. Modules are created in the app; nothing about
/// a particular organization's module list is baked in.
model Module {
  id                 String       @id @default(cuid())
  /// Optional short code the team uses, e.g. "PVD1"
  number             String?
  name               String
  status             ModuleStatus @default(not_started)
  description        String?
  audience           String?
  keyConcepts        String?
  learningObjectives String?
  toolsUsed          String?
  featuresDiscussed  String?
  /// Loose string, not a real date — teams often plan in values like "Fall 2026"
  targetCompletion   String?
  runtimeMinutes     Int?
  sizeMb             Float?
  /// Google Drive folder the app created for this module's docs
  driveFolderId      String?
  /// When the module was formally signed off. Set means done; the module is NOT
  /// archived and can still be changed.
  signedOffAt        DateTime?
  signedOffById      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  signedOffBy   User?           @relation("ModuleSignOff", fields: [signedOffById], references: [id], onDelete: SetNull)
  scenes        Scene[]
  documentLinks DocumentLink[]
  tasks         Task[]
  changeOrders  ChangeOrder[]
  versions      ModuleVersion[]
  assets        ModuleAsset[]

  @@map("modules")
}

/// A published build of a module on the delivery platform (e.g. Uptale).
/// A module can have several — one per version, and per workspace when it is
/// cloned into other organizations' workspaces.
model ModuleVersion {
  id           String    @id @default(cuid())
  moduleId     String
  /// e.g. "v3", "v2.01"
  version      String
  platform     String?
  workspace    String?
  /// The platform's ID for this build
  experienceId String?
  launchUrl    String?
  releasedAt   DateTime?
  notes        String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_versions")
}

/// A scene within a module. Doubles as the Discovery Form's per-scene capture
/// (filled early, sparse) and the general production scene list (filled in over time).
model Scene {
  id                     String  @id @default(cuid())
  moduleId               String
  order                  Int
  title                  String?
  description            String?
  location               String?
  talent                 String?
  backgroundMediaType    String?
  speaker                String?
  toolUsed               String?
  interactionHighlighted String?
  learningObjectives     String?
  /// Free-text activity notes (the structured parts are interactions/questions)
  activities             String?
  /// Checked interaction types with notes: [{ type, note }] (see src/lib/interactions.ts)
  interactions           Json    @default("[]")
  /// 1 = standard tags, 2 = custom 2D/3D elements, 3 = fully custom multi-step activity
  interactivityLevel     Int?
  /// Quiz questions: [{ question, options: [{ text, correct }], feedback }]
  questions              Json    @default("[]")
  mediaAssets            String?
  notes                  String?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  documentLinks DocumentLink[]
  assets        ModuleAsset[]

  @@map("scenes")
}

/// A link out to an artifact that lives in Google Drive/Box (storyboard, script, etc.) —
/// this app does not host or edit the document itself, per the v1 architecture decision.
model DocumentLink {
  id          String       @id @default(cuid())
  moduleId    String
  sceneId     String?
  type        DocumentType
  label       String?
  url         String
  /// Set when the file is a Google Drive file the app can read metadata for
  driveFileId String?
  addedById   String?
  addedAt     DateTime     @default(now())

  module  Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scene   Scene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  addedBy User?  @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@map("document_links")
}

/// A production task for a module, with owner, dates and status, grouped by phase.
model Task {
  id        String     @id @default(cuid())
  moduleId  String
  phase     TaskPhase
  title     String
  owner     String?
  status    TaskStatus @default(not_started)
  startDate DateTime?
  dueDate   DateTime?
  notes     String?
  order     Int        @default(0)
  /// Set on a sub-task: the task it belongs to (one level only). Deleting the parent deletes it.
  parentId  String?
  /// A playthrough: whoever owns it is expected to play the module and write up
  /// what happened, so the task gets a feedback tab instead of just a notes box.
  isPlaythrough Boolean @default(false)

  module      Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  parent      Task?                 @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]                @relation("Subtasks")
  attachments TaskAttachment[]
  feedback    PlaythroughFeedback[]

  @@index([parentId])
  @@map("tasks")
}

/// An image attached to a task or sub-task. The file lives in the Drive owner's
/// "ModuleTracker Attachments" folder; the app serves it to signed-in users.
model TaskAttachment {
  id          String   @id @default(cuid())
  /// Exactly one of taskId / assetId is set.
  taskId      String?
  assetId     String?
  driveFileId String
  name        String
  mimeType    String
  addedById   String?
  addedAt     DateTime @default(now())

  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset   ModuleAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  addedBy User?        @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([assetId])
  @@map("task_attachments")
}

/**
 * A write-up of one playthrough of a module: usually a long transcript of what the
 * person saw, said and struggled with. Several people can play the same task, and
 * one person can submit more than once, so these are rows rather than a field.
 * authorName is a snapshot so a write-up still says who wrote it later.
 */
model PlaythroughFeedback {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("playthrough_feedback")
}

/// A requested change to a module that is already signed off or deployed.
model ChangeOrder {
  id             String            @id @default(cuid())
  /// Null means the change applies to all modules
  moduleId       String?
  /// Free text, not a Scene FK — changes often span scenes (e.g. "all scenes")
  sceneRef       String?
  description    String
  status         ChangeOrderStatus @default(suggested)
  suggestedBy    String?
  suggestedDate  DateTime?
  goalDate       DateTime?
  approvedBy     String?
  completedDate  DateTime?
  versionUpdated Boolean           @default(false)
  notes          String?

  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("change_orders")
}

/// One change made in the app: who, what, when, plus enough before/after data to
/// undo it. Module id/label are plain copies (no foreign key) so history survives
/// the module being deleted.
model ActivityLog {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  actorId     String?
  actorEmail  String
  actorName   String?
  /// e.g. "task.create", "module.status", "discovery.update"
  action      String
  /// Human-readable, e.g. Moved "Film scenes 1–4" to Post-production
  summary     String
  moduleId    String?
  moduleLabel String?
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  undoneAt    DateTime?
  undoneBy    String?

  @@index([createdAt])
  @@index([moduleId, createdAt])
  @@map("activity_log")
}

/**
 * A media asset a module needs (a 2D image, 2D video, 3D object…), tracked from
 * "needed" to "in Uptale". Rows made from a scene's activities carry a sourceKey so
 * "Add from scenes" can tell which scene items are already listed.
 */
model ModuleAsset {
  id        String      @id @default(cuid())
  moduleId  String
  sceneId   String?
  name      String
  type      AssetType   @default(other)
  /// Who is providing or making it (free text, matched like task owners)
  owner     String?
  status    AssetStatus @default(needed)
  url       String?
  notes     String?
  sourceKey String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scene       Scene?           @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@index([moduleId])
  @@map("module_assets")
}

/// A chat channel: either the single always-on "team" channel (every allowlisted
/// user can read/post, no membership row needed) or a user-created group/DM
/// channel (membership in ChatChannelMember gates access).
model ChatChannel {
  id          String          @id @default(cuid())
  kind        ChatChannelKind @default(group)
  /// Null for the team channel and for a 2-person DM (the UI shows the other
  /// member's name instead); set for a named 3+ person group.
  name        String?
  createdById String?
  createdAt   DateTime        @default(now())

  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatChannelMember[]
  messages  ChatMessage[]

  @@map("chat_channels")
}

/// Who belongs to a group channel, and where they last read it. For the team
/// channel this only exists once a user has opened it (to store lastReadAt).
model ChatChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  /// Null = never opened this channel, so everything in it is unread.
  lastReadAt DateTime?
  /// Null = use the person's ChatProfile default. Set to mute just this channel.
  notifyLevel ChatNotifyLevel?
  joinedAt   DateTime  @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}

/**
 * Per-person chat settings. Separate from User because User.name and User.image are
 * overwritten from Google on every sign-in (src/auth.ts), so a chosen nickname or
 * avatar could not survive there.
 */
model ChatProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  /// Shown instead of the Google account name. Null = use User.name.
  nickname       String?
  /// An emoji used as this person's avatar; wins over their Google photo.
  emoji          String?
  /// false = never show my Google profile photo in chat.
  useGooglePhoto Boolean         @default(true)
  /// Default for channels with no ChatChannelMember.notifyLevel of their own.
  notifyLevel    ChatNotifyLevel @default(all)
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_profiles")
}

/// One chat message. Text only in v1 — no edit/delete, no attachments.
model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
  @@map("chat_messages")
}
